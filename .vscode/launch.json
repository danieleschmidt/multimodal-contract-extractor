{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: Extract CLI",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/extract.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "args": ["--help"]
    },
    {
      "name": "Python: Batch Extract CLI",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/batch_extract.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "args": ["--help"]
    },
    {
      "name": "Python: Web App",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/web_app.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: Module",
      "type": "python",
      "request": "launch",
      "module": "multimodal_contract_extractor",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: Pytest Current File",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "args": ["${relativeFile}", "-v", "--tb=short"]
    },
    {
      "name": "Python: Pytest All Tests",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "args": ["tests/", "-v", "--tb=short", "--cov=src"]
    },
    {
      "name": "Python: Pytest Integration Tests",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "args": ["tests/integration/", "-v", "--tb=short", "-m", "integration"]
    },
    {
      "name": "Python: Debug Test with Pdb",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "args": ["${relativeFile}", "-v", "--tb=short", "--pdb"]
    },
    {
      "name": "Docker: Web App",
      "type": "docker",
      "request": "launch",
      "preLaunchTask": "docker-build",
      "python": {
        "pathMappings": [
          {
            "localRoot": "${workspaceFolder}",
            "remoteRoot": "/app"
          }
        ],
        "projectType": "general"
      }
    }
  ]
}