# Enhanced security-focused Dockerfile for container scanning
# Based on the existing Dockerfile with additional security hardening

FROM python:3.12-slim-bookworm as base

# Security: Create non-root user
RUN groupadd --gid 1000 appuser && \
    useradd --uid 1000 --gid appuser --shell /bin/bash --create-home appuser

# Security: Update packages and install minimal dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        tesseract-ocr \
        poppler-utils \
        curl \
        ca-certificates && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Security: Set working directory and ownership
WORKDIR /app
RUN chown -R appuser:appuser /app

# Copy requirements first for better caching
COPY --chown=appuser:appuser requirements*.txt ./
COPY --chown=appuser:appuser pyproject.toml ./

# Security: Switch to non-root user for installations
USER appuser

# Install Python dependencies with security considerations
RUN python -m pip install --upgrade pip && \
    python -m pip install --no-cache-dir --user -r requirements.txt && \
    python -m pip install --no-cache-dir --user -r requirements-dev.txt

# Copy application code
COPY --chown=appuser:appuser . .

# Install the application
RUN python -m pip install --no-cache-dir --user -e .

# Security: Set secure environment variables
ENV PATH="/home/appuser/.local/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH="/app/src:$PYTHONPATH"

# Security: Set proper file permissions
RUN find /app -type f -exec chmod 644 {} \; && \
    find /app -type d -exec chmod 755 {} \; && \
    chmod +x /home/appuser/.local/bin/*

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import multimodal_contract_extractor; print('OK')" || exit 1

# Security: Use non-privileged port
EXPOSE 8501

# Security: Run as non-root user
USER appuser

# Default command
CMD ["streamlit", "run", "web_app.py", "--server.port=8501", "--server.address=0.0.0.0"]