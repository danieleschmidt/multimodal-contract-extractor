# Multimodal Contract Extractor - Environment Variables Example
# Copy this file to .env and update the values as needed

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment (development, staging, production)
MCE_ENV=development

# Enable debug mode (true/false)
MCE_DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
MCE_LOG_LEVEL=INFO

# Application name (used in logging and monitoring)
MCE_APP_NAME=multimodal-contract-extractor

# Application version (automatically set during deployment)
MCE_VERSION=0.1.0

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Host to bind the server to
MCE_HOST=0.0.0.0

# Port for the main application server
MCE_PORT=8501

# Base URL for the application (used for webhooks and external references)
MCE_BASE_URL=http://localhost:8501

# Maximum number of worker processes
MCE_WORKERS=4

# Worker timeout in seconds
MCE_WORKER_TIMEOUT=300

# =============================================================================
# OCR CONFIGURATION
# =============================================================================

# OCR cache size limit (number of cached results)
MCE_OCR_CACHE_SIZE_LIMIT=100

# OCR context window size for text extraction
MCE_OCR_CONTEXT_WINDOW_SIZE=100

# OCR confidence threshold (0.0 to 1.0)
MCE_OCR_CONFIDENCE_THRESHOLD=0.7

# Tesseract OCR language codes (comma-separated)
MCE_OCR_LANGUAGES=eng,fra,spa,deu

# OCR preprocessing options
MCE_OCR_ENABLE_PREPROCESSING=true
MCE_OCR_DPI=300
MCE_OCR_PSM=6

# =============================================================================
# EXTRACTION CONFIGURATION
# =============================================================================

# Base confidence score for clause extraction (0.0 to 1.0)
MCE_EXTRACTION_BASE_CONFIDENCE_SCORE=0.75

# Length bonus divisor for confidence calculation
MCE_EXTRACTION_LENGTH_BONUS_DIVISOR=1000

# Maximum confidence cap (0.0 to 1.0)
MCE_EXTRACTION_MAX_CONFIDENCE_CAP=0.95

# File size threshold in MB for streaming processing
MCE_EXTRACTION_FILE_SIZE_THRESHOLD_MB=10

# Streaming chunk size for large documents
MCE_EXTRACTION_STREAMING_CHUNK_SIZE=5

# Enable parallel processing
MCE_EXTRACTION_ENABLE_PARALLEL=true

# Maximum number of parallel processes
MCE_EXTRACTION_MAX_PARALLEL_PROCESSES=4

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Maximum file size for uploads in MB
MCE_SECURITY_MAX_FILE_SIZE_MB=100

# Request ID length limit for security validation
MCE_SECURITY_REQUEST_ID_LENGTH_LIMIT=64

# Allowed file extensions (comma-separated)
MCE_SECURITY_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tiff,.bmp

# Enable file content validation
MCE_SECURITY_VALIDATE_FILE_CONTENT=true

# Maximum number of pages per document
MCE_SECURITY_MAX_PAGES_PER_DOCUMENT=50

# Rate limiting (requests per minute per IP)
MCE_SECURITY_RATE_LIMIT_PER_MINUTE=60

# Enable CSRF protection
MCE_SECURITY_ENABLE_CSRF=true

# Secret key for session management (generate a strong random key)
MCE_SECRET_KEY=your-secret-key-here-change-this-in-production

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================

# Health check timeout in seconds
MCE_HEALTH_CHECK_TIMEOUT_SECONDS=5

# Health check interval in seconds
MCE_HEALTH_CHECK_INTERVAL_SECONDS=30

# Health check endpoint path
MCE_HEALTH_CHECK_ENDPOINT=/health

# Enable detailed health checks
MCE_HEALTH_CHECK_DETAILED=true

# =============================================================================
# DOCUMENT PROCESSING CONFIGURATION
# =============================================================================

# Default streaming chunk size for document processing
MCE_DOCUMENT_DEFAULT_STREAMING_CHUNK_SIZE=10

# Document cache TTL in seconds
MCE_DOCUMENT_CACHE_TTL=3600

# Enable document metadata extraction
MCE_DOCUMENT_EXTRACT_METADATA=true

# Document processing timeout in seconds
MCE_DOCUMENT_PROCESSING_TIMEOUT=300

# =============================================================================
# DATABASE CONFIGURATION (if using database for caching/storage)
# =============================================================================

# Database URL (for future database integration)
# MCE_DATABASE_URL=postgresql://username:password@localhost:5432/mce_db

# Redis URL for caching (if using Redis)
# MCE_REDIS_URL=redis://localhost:6379/0

# Cache expiration time in seconds
MCE_CACHE_EXPIRATION=3600

# Enable cache compression
MCE_CACHE_ENABLE_COMPRESSION=true

# =============================================================================
# STREAMLIT CONFIGURATION
# =============================================================================

# Streamlit server configuration
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=false
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Streamlit theme
STREAMLIT_THEME_PRIMARY_COLOR=#FF6B35
STREAMLIT_THEME_BACKGROUND_COLOR=#FFFFFF
STREAMLIT_THEME_SECONDARY_BACKGROUND_COLOR=#F0F2F6
STREAMLIT_THEME_TEXT_COLOR=#262730

# Streamlit upload settings
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=200
STREAMLIT_SERVER_MAX_MESSAGE_SIZE=200

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================

# Enable Prometheus metrics
MCE_METRICS_ENABLED=true

# Prometheus metrics port
MCE_METRICS_PORT=9090

# Metrics endpoint path
MCE_METRICS_ENDPOINT=/metrics

# Enable structured logging
MCE_LOGGING_STRUCTURED=true

# Log format (json, plain)
MCE_LOGGING_FORMAT=json

# Enable request correlation IDs
MCE_LOGGING_ENABLE_CORRELATION_IDS=true

# Sentry DSN for error tracking (optional)
# MCE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================

# Data directory for storing files
MCE_DATA_DIR=./data

# Logs directory
MCE_LOGS_DIR=./logs

# Cache directory
MCE_CACHE_DIR=./cache

# Temporary files directory
MCE_TMP_DIR=./tmp

# Maximum age for temporary files in hours
MCE_TMP_FILE_MAX_AGE_HOURS=24

# Enable automatic cleanup of temporary files
MCE_TMP_ENABLE_AUTO_CLEANUP=true

# =============================================================================
# CLOUD STORAGE CONFIGURATION (optional)
# =============================================================================

# AWS S3 configuration (if using S3 for storage)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_DEFAULT_REGION=us-east-1
# MCE_S3_BUCKET=your-bucket-name
# MCE_S3_PREFIX=contracts/

# Google Cloud Storage (if using GCS)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# MCE_GCS_BUCKET=your-bucket-name
# MCE_GCS_PREFIX=contracts/

# Azure Blob Storage (if using Azure)
# AZURE_STORAGE_CONNECTION_STRING=your-connection-string
# MCE_AZURE_CONTAINER=your-container-name
# MCE_AZURE_PREFIX=contracts/

# =============================================================================
# EXTERNAL API CONFIGURATION
# =============================================================================

# OpenAI API configuration (if using OpenAI for enhanced processing)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_MAX_TOKENS=2000

# Anthropic Claude API (if using Claude)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Cloud Vision API (if using for enhanced OCR)
# GOOGLE_CLOUD_VISION_API_KEY=your-vision-api-key

# Azure Cognitive Services (if using Azure AI)
# AZURE_COGNITIVE_SERVICES_KEY=your-cognitive-services-key
# AZURE_COGNITIVE_SERVICES_ENDPOINT=https://your-endpoint.cognitiveservices.azure.com/

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================

# Email configuration for notifications
# MCE_EMAIL_SMTP_HOST=smtp.gmail.com
# MCE_EMAIL_SMTP_PORT=587
# MCE_EMAIL_SMTP_USER=your-email@gmail.com
# MCE_EMAIL_SMTP_PASSWORD=your-app-password
# MCE_EMAIL_FROM_ADDRESS=noreply@your-domain.com

# Slack webhook for notifications (optional)
# MCE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Discord webhook for notifications (optional)
# MCE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Development-specific settings (only used when MCE_ENV=development)

# Enable development features
MCE_DEV_ENABLE_DEBUG_TOOLBAR=false

# Mock external services in development
MCE_DEV_MOCK_EXTERNAL_SERVICES=false

# Enable verbose logging in development
MCE_DEV_VERBOSE_LOGGING=true

# Development server auto-reload
MCE_DEV_AUTO_RELOAD=true

# Development CORS settings
MCE_DEV_ENABLE_CORS=true
MCE_DEV_CORS_ORIGINS=*

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Enable performance profiling
MCE_PERFORMANCE_PROFILING_ENABLED=false

# Performance profiling output directory
MCE_PERFORMANCE_PROFILING_DIR=./profiling

# Enable request timing logging
MCE_PERFORMANCE_LOG_REQUEST_TIMING=true

# Memory usage monitoring
MCE_PERFORMANCE_MONITOR_MEMORY=true

# Enable garbage collection tuning
MCE_PERFORMANCE_TUNE_GC=false

# =============================================================================
# EXPERIMENTAL FEATURES
# =============================================================================

# Enable experimental features (use with caution)
MCE_EXPERIMENTAL_FEATURES_ENABLED=false

# GPU acceleration (if available)
MCE_EXPERIMENTAL_GPU_ACCELERATION=false

# Advanced ML models (if available)
MCE_EXPERIMENTAL_ADVANCED_ML_MODELS=false

# Real-time processing
MCE_EXPERIMENTAL_REALTIME_PROCESSING=false

# =============================================================================
# COMPLIANCE AND AUDIT
# =============================================================================

# Enable audit logging
MCE_AUDIT_LOGGING_ENABLED=false

# Audit log directory
MCE_AUDIT_LOG_DIR=./audit_logs

# Enable GDPR compliance features
MCE_GDPR_COMPLIANCE_ENABLED=false

# Data retention period in days
MCE_DATA_RETENTION_DAYS=90

# Enable automatic data anonymization
MCE_ENABLE_DATA_ANONYMIZATION=false

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Deployment environment identifier
MCE_DEPLOYMENT_ID=local-development

# Health check URL for load balancers
MCE_HEALTH_CHECK_URL=/health

# Graceful shutdown timeout in seconds
MCE_GRACEFUL_SHUTDOWN_TIMEOUT=30

# Enable container health checks
MCE_CONTAINER_HEALTH_CHECKS=true

# Container memory limit (for resource monitoring)
MCE_CONTAINER_MEMORY_LIMIT=2048

# Container CPU limit (for resource monitoring)
MCE_CONTAINER_CPU_LIMIT=2.0